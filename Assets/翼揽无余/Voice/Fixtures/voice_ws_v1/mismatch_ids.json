{
  "wire": "voice-ws-v1",
  "valid": false,
  "event": "session/turn/playback identity mismatch",
  "doc": "INVALID: session_id, turn_id, and playback_id that are inconsistent with a single established binding. Any id that does not match the bound session/turn/stream is rejected (VOICE_PROTOCOL_BINDING_MISMATCH). Used as a negative gold sample for id mismatch enforcement.",
  "reason": "id_mismatch",
  "examples": {
    "binding": {
      "session_id": "vr-test-session-001",
      "turn_id": "turn-0001",
      "audio_stream_id": "stream-audio-001"
    },
    "mismatched_session_id": {
      "type": "audio.frame",
      "session_id": "OTHER-SESSION-999",
      "turn_id": "turn-0001",
      "audio_stream_id": "stream-audio-001",
      "sequence": 0,
      "sample_rate": 16000,
      "channels": 1,
      "timestamp_ms": 0,
      "energy": 0.0
    },
    "mismatched_turn_id": {
      "type": "audio.end",
      "session_id": "vr-test-session-001",
      "turn_id": "turn-9999",
      "audio_stream_id": "stream-audio-001"
    },
    "mismatched_audio_stream_id": {
      "type": "session.cancel",
      "session_id": "vr-test-session-001",
      "turn_id": "turn-0001",
      "audio_stream_id": "stream-OTHER-002",
      "feedback": "停止"
    },
    "mismatched_playback_id": {
      "note": "playback_id only appears on downstream tts.frame; a consumer that receives a tts.frame whose playback_id does not match the current playback handle must reject it.",
      "event": "tts.frame",
      "payload": {
        "type": "tts.frame",
        "session_id": "vr-test-session-001",
        "turn_id": "turn-0001",
        "playback_id": "playback-wrong-999",
        "sequence": 0,
        "codec": "pcm16",
        "duration_ms": 20,
        "is_final": false
      }
    }
  },
  "expected_disposition": "rejected"
}
